# Copy to `.env` in the REPO ROOT and fill in real values.
#
# This is a different file from `backend/.env`: this one is read by
# docker-compose.yml itself (for `${...}` interpolation in the compose
# file), not by Django. Both are gitignored -- only this example is
# committed. Never put a real authtoken in here.
#
# Only the optional `tunnel` profile needs these. Everything else in
# docker-compose.yml runs without a root `.env` at all:
#   docker compose --profile tunnel up -d ngrok
#
# See the comment block above the `ngrok` service in docker-compose.yml
# for how to get both values and what else has to be set alongside them
# (backend/.env's PUBLIC_API_BASE_URL and Chapa's webhook URL).

NGROK_AUTHTOKEN=
NGROK_STATIC_DOMAIN=your-name.ngrok-free.dev
