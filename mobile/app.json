{
  "expo": {
    "name": "ZNHM Ticketing",
    "slug": "znhm-ticketing",
    "scheme": "znhm",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "et.aau.znhm.ticketing",
      "supportsTablet": true
    },
    "android": {
      "package": "et.aau.znhm.ticketing"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      "expo-splash-screen",
      "expo-web-browser"
    ],
    "extra": {
      "router": {}
    }
  }
}
