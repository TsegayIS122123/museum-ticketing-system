# Copy to .env.local in this directory and adjust as needed.
#
# Points at the real backend (docker-compose.yml -> api, on :8000) by
# default, since backend/ lives right alongside this in the same repo.
#
# To work on the UI without the full Django/Postgres/Celery stack running,
# point this at the optional Prism mock instead:
#   docker compose --profile mock up mock-api
#   NEXT_PUBLIC_API_URL=http://localhost:4010


NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
API_INTERNAL_URL=http://api:8000/api/v1

# NEXT_PUBLIC_API_URL=http://localhost:4010/api/v1
# API_INTERNAL_URL=http://mock-api:4010/api/v1