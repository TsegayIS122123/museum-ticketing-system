# Copy to .env in this directory and fill in real values.
# Never commit the actual .env file.

DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-random-secret
ALLOWED_HOSTS=*

# Matches the `db` service in docker-compose.yml
DATABASE_URL=postgres://museum_ticketing:museum_ticketing@db:5432/museum_ticketing

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Matches the `redis` service. DB 0 = celery broker, 1 = category/
# availability cache, 2 = rate-limit counters (Design Spec Sec 6.2).
REDIS_URL=redis://redis:6379

# Object storage -- DISABLED for now, using local filesystem storage
# (media/ folder) instead. Uncomment these and the matching settings in
# config/settings/base.py once a MinIO container or a paid managed S3
# account is ready to use (ADR-005):
# AWS_STORAGE_BUCKET_NAME=museum-ticketing
# AWS_S3_ENDPOINT_URL=http://minio:9000
# AWS_ACCESS_KEY_ID=museum_ticketing
# AWS_SECRET_ACCESS_KEY=museum_ticketing

# Fiscal-year boundary underlying NFR-RETENTION-001 (open question, Doc 02 Sec 5)
FISCAL_YEAR_START_MONTH=7
FISCAL_YEAR_START_DAY=1

# Chapa -- payment aggregator; Telebirr/CBE Birr/card all route through it
# (ADR-008). Sandbox keys only outside production (Doc 08 Sec 3.2).
CHAPA_PUBLIC_KEY=
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# Publicly reachable base URLs Chapa needs for its checkout session's
# callback_url (webhook) and return_url (post-payment browser redirect).
# Defaults below match docker-compose.yml for local dev; a real deployment
# overrides both with its actual public hostnames (Doc 08).
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_WEB_BASE_URL=http://localhost:3000


# SMS is the primary Visitor OTP channel (FR-ACC-001); email is the
# magic-link fallback + Staff password-reset channel.
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Error tracking (production only -- sentry_sdk.init() in
# config/settings/production.py is a no-op if SENTRY_DSN is unset).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
GIT_COMMIT_SHA=