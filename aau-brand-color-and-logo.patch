+  /* AAU brand secondary — same blue family as primary, just a different
+     intensity plane. The design only uses two colors (blue + white), so
+     "secondary" is an alias of the primary scale rather than a separate
+     gold hue. Kept as its own token set so every existing secondary
+     utility class (bg-secondary-N, text-secondary-N, ring-secondary-N,
+     etc.) still works, it now simply renders in blue instead of gold. */
+  --color-secondary-50: var(--color-primary-50);
+  --color-secondary-100: var(--color-primary-100);
