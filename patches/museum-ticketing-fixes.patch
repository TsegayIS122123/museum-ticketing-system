+  groupTin: z.string().trim()
+    .min(5, 'TIN looks too short')
+    .max(20, 'TIN looks too long')
+    .regex(/^\d+$/, 'TIN should contain digits only'),
 });
 
 export type GroupVisitRequestInput = z.infer<typeof groupVisitRequestSchema>;
